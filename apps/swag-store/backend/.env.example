# Swag Store backend — local settings. Copy to .env; real env vars always win.
# Values are single-line strings. Never commit .env.

# --- Server ---
PORT=8080
# REST_READ_TIMEOUT=60s
# REST_WRITE_TIMEOUT=60s
# UPSTREAM_TIMEOUT=25s
CORS_ALLOWED_ORIGINS=http://localhost:3000
# JOBS_ENABLED=true

# --- Auth (x-jwt-assertion) ---
AUTH_JWKS_ENDPOINT=https://idp.example/oauth2/jwks
AUTH_ISSUER=https://idp.example/oauth2/token
AUTH_AUDIENCE=your-client-id
# Local only: decode without a signature check. Startup refuses it unless every upstream is loopback.
AUTH_TOKEN_VALIDATOR_ENABLED=false
# AUTH_ALLOWED_EMAIL_DOMAINS=wso2.com
# Comma lists of token "groups" values. Unset = nobody holds the role.
AUTH_CATALOG_MANAGER_GROUPS=swag-catalog-managers
AUTH_FULFILMENT_OPS_GROUPS=swag-fulfilment-ops

# --- Database (DATABASE_URL, or the DB_* set) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=swag
DB_PASSWORD=change-me
DB_NAME=hris_swag_store
DB_TLS=false
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...
# DB_MAX_OPEN_CONNS=10

# --- Shared OAuth2 client-credentials app (maps to the store treasury in transaction-service) ---
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_TOKEN_URL=http://127.0.0.1:8081/token

# --- Upstreams (go run ./cmd/fakes serves all of them on 127.0.0.1:8081) ---
TRANSACTION_SERVICE_BASE_URL=http://127.0.0.1:8081
# TRANSACTION_SERVICE_SCOPES=
HR_ENTITY_BASE_URL=http://127.0.0.1:8081/graphql
# HR_ENTITY_SCOPES=
# HR_ENTITY_TOKEN_URL= / HR_ENTITY_CLIENT_ID= / HR_ENTITY_CLIENT_SECRET=  (own app, if HR needs one)
EMAIL_BASE_URL=http://127.0.0.1:8081
EMAIL_FROM_ADDRESS=noreply@example.com
# Every email goes only to these, as a "[Test copy]". Set it in every non-production environment.
EMAIL_DEBUG_RECIPIENTS=you@example.com

# --- Store rules ---
# The only payee a payment can name. Cross-checked against /wallets/master/balance.
STORE_TREASURY_WALLET_ADDRESS=0xfa4e00000000000000000000000000000000beef
STORE_CONTACT_EMAIL=swag-store@example.com
STORE_WEB_URL=http://localhost:3000
# HR_CACHE_TTL=1h
# LOW_STOCK_THRESHOLD=5
# PICKUP_REMINDER_DAYS=7
# UNCOLLECTED_FLAG_DAYS=30
# STORE_TIMEZONE=Asia/Colombo

# --- Product photos (Azure Blob) ---
# Unset: uploads answer 503 assets_not_configured and every photo URL is null.
# In Azure: the account URL only; the backend signs in with its Entra identity
# (a managed identity, or AZURE_TENANT_ID + AZURE_CLIENT_ID + AZURE_CLIENT_SECRET).
# ASSETS_ACCOUNT_URL=https://<account>.blob.core.windows.net
# ASSETS_CONTAINER=swag-store-assets
# ASSETS_MAX_UPLOAD_BYTES=5242880
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# Local runs with the Azurite emulator (README): its account URL and published development key.
# ASSETS_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
# ASSETS_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# --- Integration tests (make test-integration) ---
# SWAG_TEST_DATABASE_URL=root:pw@tcp(127.0.0.1:3306)/

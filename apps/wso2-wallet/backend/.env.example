PORT=:8081
# Exact allowed origin for cross-origin requests. Leave empty to disable
# cross-origin responses (deny by default); do not use "*" in deployed envs.
CORS_ALLOWED_ORIGIN=

# JWT verification. Set JWT_JWKS_URL to the identity provider's JWKS endpoint so
# token signatures are verified; leave empty only for local development (tokens
# are then decoded but not verified). JWT_ISSUER/JWT_AUDIENCE, when set, are
# additionally checked against the token's iss/aud claims.
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wso2_wallet
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=25
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# AES-256 key, 32 bytes base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# One-time allocation granted on a user's first wallet.
INITIAL_COINS_ENABLED=true
INITIAL_COINS_AMOUNT=10
INITIAL_COINS_FUNDING_WALLET=
INITIAL_COINS_EMAIL_DOMAIN=wso2.com

# Maintenance mode. When true, the app shows a maintenance screen carrying
# MAINTENANCE_MESSAGE. Toggling requires updating these values and restarting.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

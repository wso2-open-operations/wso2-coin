PORT=:8081
CORS_ALLOWED_ORIGIN=*

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wso2_wallet
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=25
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# AES-256 key, 32 bytes base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=

# One-time allocation granted on a user's first wallet.
INITIAL_COINS_ENABLED=true
INITIAL_COINS_AMOUNT=10
INITIAL_COINS_FUNDING_WALLET=
INITIAL_COINS_EMAIL_DOMAIN=wso2.com

# Port the service listens on. A bare number (e.g. 8080) is normalized to ":8080".
# Choreo injects PORT=8080, which this normalizes to ":8080".
PORT=:8080

# Exact allowed origin for cross-origin requests. Leave empty to disable
# cross-origin responses (deny by default); do not use "*" in deployed envs.
CORS_ALLOWED_ORIGIN=

# JWT verification. Set JWT_JWKS_URL to the identity provider's JWKS endpoint so
# token signatures are verified (required for every deployed environment). The
# caller is identified by the token's subject (sub) claim, treated as the client id.
# JWT_ISSUER/JWT_AUDIENCE, when set, are additionally checked against the token's
# iss/aud claims. If JWT_JWKS_URL is empty the service refuses to start unless
# JWT_ALLOW_INSECURE=true — local development only, where tokens are decoded but
# not verified.
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALLOW_INSECURE=false

# End-user token verification for the POST /payments endpoint. The payment carries a
# second token identifying the end user, read from USER_ASSERTION_HEADER (default
# X-User-Assertion). Each USER_JWT_* below falls back to its JWT_* counterpart, so when
# the user token shares the service token's issuer only the JWT_* config is needed;
# set a USER_JWT_* value only to override for a differently-issued user token. The
# payments endpoint is enabled once an effective JWKS URL is present or (JWT_ or
# USER_JWT_)ALLOW_INSECURE is true (decode-only, local development only).
USER_ASSERTION_HEADER=X-User-Assertion
USER_JWT_JWKS_URL=
USER_JWT_ISSUER=
USER_JWT_AUDIENCE=
USER_JWT_ALLOW_INSECURE=

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wso2_wallet
# TLS mode for the DB connection (go-sql-driver): "true" verifies the server cert +
# hostname (use for managed DBs), "preferred" uses TLS opportunistically without
# verification, "skip-verify" encrypts without verification, "false" disables TLS.
DB_TLS=preferred
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=25
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10

# AES-256 key, 32 bytes base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=
